        "url": "={{ $env.HA_BASE_URL }}/api/states/climate.thermostat_hc1",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {}
      },
      "id": "http-heizkreis",
      "name": "HA: Heizkreis-Status lesen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-740, 340],
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_HA_TOKEN_CREDENTIAL_ID",
