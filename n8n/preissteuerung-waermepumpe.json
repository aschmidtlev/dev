        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"entity_id\": \"climate.thermostat_hc1\", \"hvac_mode\": \"{{ $json.climate_hvac_mode }}\"}",
        "options": {}
      },
      "id": "http-boost-setzen",
      "name": "HA: Heizkreis-Modus setzen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
