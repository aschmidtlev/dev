                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-boost",
      "name": "Boost-Änderung nötig?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-20, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HA_BASE_URL }}/api/services/switch/{{ $json.sperre_service }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"entity_id\": \"switch.boiler_heatingoff\"}",
        "options": {}
      },
      "id": "http-sperre-setzen",
      "name": "HA: Wärmepumpe sperren/freigeben",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 60],
      "credentials": {
