    {
      "parameters": {
        "numberInputs": 3
      },
      "id": "merge-inputs",
      "name": "Werte zusammenführen",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [-500, 200]
    },
    {
      "parameters": {
        "jsCode": "// --- Konfiguration: hier anpassen, keine eigenen HA-Helper nötig ---\n// Schwellen als Perzentil (0-1) statt fixer ct/kWh-Werte: passen sich automatisch an\n// das Preisniveau des jeweiligen Tages an (dynamisch statt starr), Basis ist das native\n// intraday_price_ranking-Attribut der offiziellen Tibber-Integration (0 = günstigste,\n// 1 = teuerste Stunde des Tages).\nconst sperrschwelle = 0.85;    // teuerste 15% der Stunden -> sperren\nconst boostschwelle = 0.15;    // günstigste 15% der Stunden -> boosten\nconst hysterese = 0.05;        // Perzentil-Puffer gegen Takten am Schwellwert\n// ---------------------------------------------------------------\n\nconst rang = parseFloat($input.all()[0].json.attributes.intraday_price_ranking);\nconst sperreAktuellAn = $input.all()[1].json.state === 'on'; // switch.boiler_heatingoff an = aktuell gesperrt\nconst hvacAktuell = $input.all()[2].json.state; // 'auto' | 'heat'\n\n// Sperre: switch.boiler_heatingoff (natives EMS-ESP-Signal \"Force heating off\") einschalten,\n// wenn der Preisrang deutlich über der Schwelle liegt, wieder ausschalten wenn deutlich darunter.\nlet sperre_service = null;\nif (!sperreAktuellAn && rang > sperrschwelle + hysterese) {\n  sperre_service = 'turn_on'; // Force heating off aktivieren = sperren\n} else if (sperreAktuellAn && rang <= sperrschwelle - hysterese) {\n  sperre_service = 'turn_off'; // Sperre aufheben\n}\n\n// Boost: hvac_mode 'heat' erzwingt aktives Heizen (statt witterungsgeführt 'auto'),\n// wenn der Preisrang günstig ist. Keine Änderung, wenn gerade gesperrt wird/ist.\nlet climate_hvac_mode = null;\nconst wirdOderIstGesperrt = sperre_service === 'turn_on' || (sperreAktuellAn && sperre_service !== 'turn_off');\nif (!wirdOderIstGesperrt) {\n  if (hvacAktuell !== 'heat' && rang < boostschwelle - hysterese) {\n    climate_hvac_mode = 'heat';\n  } else if (hvacAktuell !== 'auto' && rang >= boostschwelle + hysterese) {\n    climate_hvac_mode = 'auto';\n  }\n}\n\nreturn [{\n  json: { rang, sperreAktuellAn, hvacAktuell, sperre_service, climate_hvac_mode }\n}];"
      },
      "id": "code-entscheidung",
      "name": "Entscheidung berechnen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-260, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.sperre_service }}",
              "rightValue": null,
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-sperre",
      "name": "Sperre-Änderung nötig?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-20, 100]
    },
